  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  Dialogues:
  - lines:
    - "Livros sobre correntes mar\xEDtimas.  Press\xE3o oce\xE2nica.  Navega\xE7\xE3o."
    - "Voc\xEA l\xEA algumas p\xE1ginas."
    - "As palavras entram\u2026e saem da cabe\xE7a logo depois."
    - "Segunda-feira \xE9 um p\xE9ssimo dia para ler."
    LineSprites: []
    RequiredMissionIndex: -1
    RequiredEmotion: 0
    RequiredHeldFish: 0
    RequiredDayIndex: 1
    IsExtra: 0
    CompletesMission: 0
    EmotionToGive: 0
    UnlocksMap: 0
    BedTime: 0
  - lines:
    - "As p\xE1ginas falam sobre estrat\xE9gia militar."
    - "Probabilidades. Perdas aceit\xE1veis. Efici\xEAncia."
    - "Voc\xEA reconhece algumas anota\xE7\xF5es nas margens."
    - Sua letra.
    - "Voc\xEA fecha o livro com for\xE7a."
