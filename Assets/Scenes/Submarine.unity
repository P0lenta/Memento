  m_Script: {fileID: 11500000, guid: 7af502cdc0995bd0daf61a8c1b8ef90a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  Dialogues:
  - lines:
    - 'Uma carta. '
    - 'De uma pessoa amada. '
    - "Voc\xEA decorou cada linha h\xE1 muito tempo. "
    - "\u201CN\xE3o importa quanto tempo demore.  Voc\xEA sempre encontra o caminho
      de volta.\u201D"
    - "Voc\xEA sorri sem perceber."
    LineSprites: []
    RequiredMissionIndex: -1
    RequiredEmotion: 0
    RequiredHeldFish: 0
    RequiredDayIndex: 1
    IsExtra: 0
    CompletesMission: 0
    EmotionToGive: 1
    UnlocksMap: 0
    BedTime: 0
  - lines:
    - A carta parece menor hoje.
    - "Ou talvez seja voc\xEA."
    - "\u201CPromete que volta inteiro.\u201D"
    - "Voc\xEA l\xEA a frase v\xE1rias vezes."
    - "Nenhum dos dois sabia o que \u201Cinteiro\u201D significava naquela \xE9poca."
    LineSprites: []
    RequiredMissionIndex: -1
    RequiredEmotion: 0
    RequiredHeldFish: 0
    RequiredDayIndex: 2
    IsExtra: 0
    CompletesMission: 0
    EmotionToGive: 2
    UnlocksMap: 0
    BedTime: 0
