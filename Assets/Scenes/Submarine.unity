--- !u!114 &478308179
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 478308170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7af502cdc0995bd0daf61a8c1b8ef90a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  Dialogues:
  - lines:
    - "A fita chia antes da grava\xE7\xE3o come\xE7ar."
    - "N\xE3o faz muito tempo desde que voc\xEA ouviu pela \xFAltima vez."
    - "Mesmo assim\u2026 o sentimento de ouvir a voz dessa pessoa ainda aperta seu
      peito."
    LineSprites: []
    RequiredMissionIndex: -1
    RequiredEmotion: 0
    RequiredHeldFish: 0
    RequiredDayIndex: 1
    IsExtra: 0
    CompletesMission: 0
    EmotionToGive: 2
    UnlocksMap: 0
    BedTime: 0
  - lines:
    - "Voc\xEA aperta play esperando a mesma grava\xE7\xE3o de sempre."
    - "Mas dessa vez\u2026"
    - "\u201CPai?\u201D"
    - "Sil\xEAncio."
    - "\u201C\u2026por que voc\xEA t\xE1 chorando?\u201D"
    - "Voc\xEA n\xE3o lembra dessa parte."
    - A fita continua girando.
    - "Pela primeira vez em muito tempo\u2026 suas m\xE3os tremem."
    LineSprites: []
    RequiredMissionIndex: -1
    RequiredEmotion: 0
    RequiredHeldFish: 0
    RequiredDayIndex: 2
    IsExtra: 0
    CompletesMission: 0
    EmotionToGive: 5
    UnlocksMap: 0
    BedTime: 0
